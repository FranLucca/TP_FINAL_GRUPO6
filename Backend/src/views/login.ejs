<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Define la codificación de caracteres del documento. -->
    <meta charset="UTF-8">

    <!-- Configura la visualización para adaptar la página al ancho del dispositivo. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Define el título de la página utilizando una variable recibida desde el backend. -->
    <title>FutbolTotal | <%= title %></title>

    <!-- Estilos -->
    <!-- Vincula la hoja de estilos general de la aplicación. -->
    <link rel="stylesheet" href="css/style.css">

    <!-- Vincula los estilos específicos de la pantalla de inicio de sesión. -->
    <link rel="stylesheet" href="css/login.css">
</head>
<body>

    <!-- Encabezado principal de la página. -->
    <header class="encabezado">
        <!-- Contenedor que agrupa el logo y el nombre del proyecto. -->
        <div class="marca">
            <!-- Enlace que permite volver a la ruta de inicio de sesión. -->
            <a href="/login">
                <!-- Muestra el logo de FutbolTotal. -->
                <img src="img/logo.png" alt="Logo FutbolTotal">
            </a>

            <!-- Contenedor con el nombre del proyecto y los integrantes. -->
            <div>
                <h1>Futbol<span>Total</span></h1>
                <small>Luca Kosinski | Martino Monsalvo | Franco Lucca</small>
            </div>
        </div>
    </header>

    <!-- Contenedor principal de la pantalla de inicio de sesión. -->
    <main class="contenedor-login">
        <!-- Tarjeta que contiene los elementos del formulario de acceso. -->
        <section class="tarjeta-login">
            <!-- Presentación del nombre y la sección del sistema. -->
            <div class="marca-login">
                <h1>Futbol<span>Total</span></h1>
                <p>Panel de administración</p>
            </div>

            <!-- Título del formulario de acceso. -->
            <h2>Iniciar sesión</h2>

            <!-- Formulario que envía los datos de acceso al servidor mediante POST. -->
            <form action="/login" method="POST">
                <!-- Grupo de campos correspondiente al correo electrónico. -->
                <div class="grupo-login">
                    <label for="email">Correo electrónico</label>
                    <!-- Campo de tipo email para ingresar el correo del administrador. -->
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Ingresá tu correo"
                        required
                    >
                </div>

                <!-- Grupo de campos correspondiente a la contraseña. -->
                <div class="grupo-login">
                    <label for="password">Contraseña</label>
                    <!-- Campo de tipo password que oculta los caracteres ingresados. -->
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Ingresá tu contraseña"
                        required
                    >
                </div>

                <!-- Comprueba que exista la variable error y que tenga un valor verdadero. -->
                <% if (typeof error !== "undefined" && error) { %>
                    <!-- Si existe un error, muestra su contenido en la página. -->
                    <p class="mensaje-error"><%= error %></p>
                <!-- Finaliza la condición de EJS. -->
                <% } %>

                <!-- Botón que envía el formulario para iniciar sesión. -->
                <button type="submit" class="boton-ingresar">
                    Ingresar
                </button>

                <!-- Botón que permite completar automáticamente los campos de acceso. -->
                <button type="button" id="btn-autocompletar" class="boton-ingresar">
                    Autocompletar admin
                </button>
            </form>
        </section>
    </main>

    <!-- Incluye el pie de página reutilizable de la aplicación. -->
    <%- include("./partials/footer.ejs") %>

    <!-- Código JavaScript encargado de autocompletar los datos del administrador. -->
    <script>
            // Busca el botón de autocompletar y agrega un evento para detectar el clic.
            document.getElementById("btn-autocompletar").addEventListener("click", () => {

            // Busca el campo de correo electrónico y establece su valor.
            document.getElementById("email").value = "admin@gmail.com";

            // Busca el campo de contraseña y establece su valor.
            document.getElementById("password").value = "admin123";
        });
    </script>
</body>
</html>